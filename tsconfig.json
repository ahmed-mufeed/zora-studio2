{
  "compilerOptions": {
    /* ================================================================
       1. بيئة التشغيل المستهدفة وإصدارات اللغة
       ================================================================ */
    "target": "ES2020", /* معيار إصدار الجافا سكريبت المستهدف في الناتج النهائي */
    "useDefineForClassFields": true, /* الالتزام بالمعايير القياسية لحقول الكلاسات */
    "lib": ["ES2020", "DOM", "DOM.Iterable"], /* المكتبات البرمجية المضمنة (خصائص المتصفح والـ DOM) */
    "module": "ESNext", /* نظام الموديولات المستهدف في الكود */
    "skipLibCheck": true, /* تخطي تدقيق ملفات التعريفات الخارجية (.d.ts) لتسريع عملية الفحص */
    "types": ["node"], /* تضمين تعريفات بيئة Node.js */

    /* ================================================================
       2. التوافق مع أداة البناء ومحرك التجميع (Bundler Mode)
       ================================================================ */
    "moduleResolution": "bundler", /* أسلوب حل واستكشاف مسارات الحزم المتوافق مع Vite */
    "allowImportingTsExtensions": true, /* إمكانية استيراد ملفات TypeScript المباشرة */
    "resolveJsonModule": true, /* السماح باستيراد ملفات JSON داخل الأكواد */
    "isolatedModules": true, /* التأكد من إمكانية تحويل كل ملف بشكل مستقل */
    "noEmit": true, /* عدم توليد ملفات JS ناتجة والاعتماد على Vite للبناء */
    "jsx": "react-jsx", /* دعم معالج JSX الحديث المخصص لـ React */

    /* ================================================================
       3. المسارات المختصرة والمطابقة (Path Mapping)
       ================================================================ */
    "baseUrl": ".", /* المجلد الجذري الأساسي للبحث عن الملفات */
    "paths": {
      "@/*": ["src/*"] /* إتاحة استخدام @ للإشارة المباشرة إلى مجلد src */
    },

    /* ================================================================
       4. معايير التدقيق البرمجي الصارم ونظافة الكود (Linting & Strictness)
       ================================================================ */
    "strict": true, /* تفعيل كافة شروط الفحص الصارم للأنواع */
    "noUnusedLocals": true, /* إظهار خطأ عند وجود متغيرات محلية غير مستخدمة */
    "noUnusedParameters": true, /* إظهار خطأ عند وجود معاملات دوال غير مستخدمة */
    "noFallthroughCasesInSwitch": true /* منع الانتقال غير المقصود بين حالات جمل switch */
  },
  
  /* المجلدات والملفات المشمولة في نطاق تدقيق TypeScript */
  "include": ["src", "vite.config.ts"]
}